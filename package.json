{
  "name": "bug-categorizer",
  "version": "1.0.1",
  "description": "Azure BugCat turns a messy Azure DevOps bug backlog into categorized, deduplicated, triage-ready groups — locally, with the LLM provider you choose",
  "author": "Gabriele Versino",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elverle/Azure_BugCat.git"
  },
  "homepage": "https://github.com/Elverle/Azure_BugCat",
  "bugs": {
    "url": "https://github.com/Elverle/Azure_BugCat/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@fontsource/inter": "^5.2.8",
    "@google/genai": "^1.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.14.0",
    "node-machine-id": "^1.1.12",
    "openai": "^6.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.gversino.bugcat",
    "productName": "Azure BugCat",
    "asar": true,
    "extraMetadata": {
      "main": "./out/main/index.js"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
